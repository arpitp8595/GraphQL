input CountryInput {
    name: String
    code: String
}

type Country {
    code: String
    name: String
    capital: String
    currency: String
}

type Query {
    allCountries: [Country]
    # GraphQL requires at least one query
    health: String
}


input UserRequest {
    name: String
    job: String
}

type UserResponse {
    name: String
    job: String
    id: String
    createdAt: String
}

input JsonPostRequest {
    title: String
    body: String
    userId: Int
}

type JsonPostResponse {
    id: Int
    title: String
    body: String
    userId: Int
}

type Mutation {
    getCountryByInput(request: CountryInput): Country
    createUser(input: UserRequest): UserResponse
    createPost(request: JsonPostRequest): JsonPostResponse

    processWithLastName(input: CardLastNameInput!): ProcessResult!
    processWithAccount(input: CardAccountInput!): ProcessResult!
    processWithEmail(input: CardEmailInput!): ProcessResult!
}

input CardLastNameInput {
    cardNumber: String!
    lastName: String!
}

input CardAccountInput {
    cardNumber: String!
    accountNumber: String!
}

input CardEmailInput {
    cardNumber: String!
    email: String!
}

type ProcessResult {
    success: Boolean!
    message: String!
    transactionId: String
    status: String!
}